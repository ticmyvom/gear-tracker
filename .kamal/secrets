# Secrets for config/deploy.yml. Kamal reads them from your shell's environment
# (or a command) when you deploy, so this file is safe for git. NEVER put a
# real value here. See docs/hosting.md for where each one comes from.
#
# Safer still: keep them in a password manager and fetch them, for example:
# SECRETS=$(kamal secrets fetch --adapter bitwarden --account you@example.com SMTP_PASSWORD ...)
# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD ${SECRETS})

# Decrypts config/credentials.yml.enc. Never commit config/master.key.
RAILS_MASTER_KEY=$(cat config/master.key)

# A sending-only Resend API key, for password reset emails.
SMTP_PASSWORD=$SMTP_PASSWORD

# Cloudflare R2 (or other S3-compatible) bucket and access key for Litestream backups.
LITESTREAM_REPLICA_BUCKET=$LITESTREAM_REPLICA_BUCKET
LITESTREAM_REPLICA_ENDPOINT=$LITESTREAM_REPLICA_ENDPOINT
LITESTREAM_ACCESS_KEY_ID=$LITESTREAM_ACCESS_KEY_ID
LITESTREAM_SECRET_ACCESS_KEY=$LITESTREAM_SECRET_ACCESS_KEY
