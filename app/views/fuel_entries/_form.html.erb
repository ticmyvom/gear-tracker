<%= form_with model: [ gear, fuel_entry ] do |form| %>
  <%= render "shared/errors", record: fuel_entry %>
  <%= form.hidden_field :unit if fuel_entry.new_record? %>

  <div>
    <%= form.label :entered_amount, "#{fuel_entry.electric? ? "Energy" : "Fuel"} (#{fuel_entry.amount_label})" %>
    <%= form.number_field :entered_amount, required: true, autofocus: true, min: 0.001, step: "0.001", inputmode: "decimal" %>
  </div>
  <%= render "shared/money_field", form: form, field: :total_price, label: "Total price (optional)" %>
  <fieldset>
    <legend>Time used (optional)</legend>
    <div class="inline-fields">
      <label><%= form.number_field :used_hours, min: 0, step: "any", inputmode: "decimal" %> h</label>
      <label><%= form.number_field :used_minutes, min: 0, step: 1, inputmode: "numeric" %> min</label>
    </div>
  </fieldset>
  <% if gear.vehicle? || fuel_entry.entered_odometer.present? || fuel_entry.entered_trip.present? %>
    <div>
      <%= form.label :entered_odometer, "Current odometer (#{fuel_entry.distance_label}, optional)" %>
      <%= form.number_field :entered_odometer, min: 0, step: "0.1", inputmode: "decimal" %>
    </div>
    <div>
      <%= form.label :entered_trip, "#{fuel_entry.electric? ? "Distance driven" : "Distance since last fill-up"} (#{fuel_entry.distance_label}, optional)" %>
      <%= form.number_field :entered_trip, min: 0, step: "0.1", inputmode: "decimal" %>
      <% if gear.fuel_units.one? %>
        <p class="muted">Left blank, it's worked out from the odometers.</p>
      <% end %>
    </div>
    <div>
      <%= form.label :filled_up do %>
        <%= form.check_box :filled_up %> <%= fuel_entry.electric? ? "Charged to your usual level" : "Filled up (full tank)" %>
      <% end %>
    </div>
    <div>
      <%= form.label :missed_previous do %>
        <%= form.check_box :missed_previous %> I missed logging a <%= fuel_entry.electric? ? "charge" : "fill-up" %> before this one
      <% end %>
      <p class="muted">Leaves this one out of efficiency, unless you type the distance since the one you missed.</p>
    </div>
  <% end %>
  <div>
    <%= form.label :filled_on, "Date" %>
    <%= form.date_field :filled_on %>
  </div>
  <%= render "shared/notes_field", form: form %>
  <div class="actions">
    <%= form.submit "Save #{fuel_entry.label}" %>
    <%= link_to "Cancel", gear %>
  </div>
<% end %>

<% if fuel_entry.persisted? %>
  <p><%= button_to "Delete #{fuel_entry.label}", [ gear, fuel_entry ], method: :delete, data: { turbo_confirm: "Delete this #{fuel_entry.label}?" } %></p>
<% end %>
