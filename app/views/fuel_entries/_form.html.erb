<%= form_with model: [ gear, fuel_entry ] do |form| %>
  <%= render "shared/errors", record: fuel_entry %>
  <%= form.hidden_field :unit if fuel_entry.new_record? %>

  <div>
    <%= form.label :amount, fuel_entry.electric? ? "Energy (kWh)" : "Fuel (gallons)" %>
    <%= form.number_field :amount, required: true, autofocus: true, min: 0.001, step: "0.001", inputmode: "decimal" %>
  </div>
  <div>
    <%= form.label :total_price, "Total price (optional)" %>
    <%= form.number_field :total_price, min: 0, step: "0.01", inputmode: "decimal" %>
  </div>
  <div>
    <%= form.label :minutes, "Minutes of use (optional)" %>
    <%= form.number_field :minutes, min: 1, step: 1, inputmode: "numeric" %>
  </div>
  <% if gear.vehicle? || fuel_entry.odometer || fuel_entry.trip %>
    <div>
      <%= form.label :odometer, "Current odometer (optional)" %>
      <%= form.number_field :odometer, min: 0, step: "0.1", inputmode: "decimal" %>
    </div>
    <div>
      <%= form.label :trip, fuel_entry.electric? ? "Miles driven (optional)" : "Miles since last fill-up (optional)" %>
      <%= form.number_field :trip, min: 0, step: "0.1", inputmode: "decimal" %>
    </div>
  <% end %>
  <div>
    <%= form.label :filled_on, "Date" %>
    <%= form.date_field :filled_on %>
  </div>
  <div class="actions">
    <%= form.submit "Save #{fuel_entry.label}" %>
    <%= link_to "Cancel", gear %>
  </div>
<% end %>

<% if fuel_entry.persisted? %>
  <p><%= button_to "Delete #{fuel_entry.label}", [ gear, fuel_entry ], method: :delete, data: { turbo_confirm: "Delete this #{fuel_entry.label}?" } %></p>
<% end %>
