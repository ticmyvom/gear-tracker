<%= form_with model: gear do |form| %>
  <%= render "shared/errors", record: gear %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name, required: true, autofocus: true, placeholder: "2010 Toyota Prius" %>
  </div>
  <div>
    <%= form.label :category %>
    <%= form.select :category, Gear::CATEGORIES.invert, include_blank: "None" %>
  </div>
  <div>
    <%= form.label :power_source, "Powered by" %>
    <%= form.select :power_source, Gear::POWER_SOURCES.invert, include_blank: "Not powered" %>
  </div>
  <% unless gear.components.any? %>
    <div>
      <%= form.label :parent_id, "Component of" %>
      <%= form.collection_select :parent_id, parent_options, :id, :name, include_blank: "Nothing (standalone gear)" %>
    </div>
  <% end %>
  <div>
    <%= form.label :purchased_on, "Purchase date" %>
    <%= form.date_field :purchased_on %>
  </div>
  <%= render "shared/money_field", form: form, field: :price, label: "Price" %>
  <div>
    <%= form.label :purchased_from, "Bought from" %>
    <%= form.text_field :purchased_from %>
  </div>
  <%= render "shared/notes_field", form: form %>
  <% if gear.parent_id.nil? %>
    <fieldset>
      <legend>Public profile</legend>
      <div>
        <%= form.label :public do %>
          <%= form.check_box :public %> Show on my public profile
        <% end %>
        <p class="muted">Shows its name, category, power source and components.
          <%= "Your profile is private, so nobody sees it until you make your profile public in Settings." unless Current.user.profile_public? %></p>
      </div>
      <div>
        <%= form.label :public_costs do %>
          <%= form.check_box :public_costs %> Also show its total cost and cost per year
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <div class="actions">
    <%= form.submit %>
    <%= link_to "Cancel", gear.persisted? ? gear : gears_path %>
  </div>
<% end %>
