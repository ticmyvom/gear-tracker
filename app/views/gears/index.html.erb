<% content_for :title, "My gear" %>
<div class="actions">
  <h1>My gear</h1>
  <%= link_to "Add gear", new_gear_path %>
</div>

<% if @gears.empty? %>
  <p class="muted">Nothing yet. Add the first thing you own and intend to keep.</p>
<% else %>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Purchased</th>
          <th>From</th>
          <th class="num">Price</th>
          <th class="num">Total cost</th>
          <th class="num">Per year</th>
        </tr>
      </thead>
      <tbody>
        <% @gears.each do |gear| %>
          <tr>
            <td><%= link_to gear.name, gear %></td>
            <td><%= gear.category %></td>
            <td><%= gear.purchased_on %></td>
            <td><%= gear.purchased_from %></td>
            <td class="num"><%= money gear.price %></td>
            <td class="num"><%= money gear.total_cost %></td>
            <td class="num"><%= money gear.cost_per_year %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="5">Total</th>
          <th class="num"><%= money @gears.sum(&:total_cost) %></th>
          <th></th>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>
