<% content_for :title, @gear.name %>
<% if @gear.parent %>
  <p><%= link_to "< #{@gear.parent.name}", @gear.parent %></p>
<% else %>
  <p><%= link_to "< My gear", gears_path %></p>
<% end %>

<h1><%= @gear.name %></h1>

<dl>
  <dt>Category</dt><dd><%= @gear.category.presence || "-" %></dd>
  <dt>Purchased</dt><dd><%= @gear.purchased_on || "-" %></dd>
  <dt>Bought from</dt><dd><%= @gear.purchased_from.presence || "-" %></dd>
  <dt>Price</dt><dd><%= money @gear.price %></dd>
  <dt>Total cost</dt><dd><%= money @gear.total_cost %></dd>
  <dt>Cost per year</dt><dd><%= money @gear.cost_per_year %></dd>
</dl>

<% if @gear.notes.present? %>
  <p class="notes"><%= @gear.notes %></p>
<% end %>

<div class="actions">
  <%= link_to "Edit", edit_gear_path(@gear) %>
  <%= button_to "Delete", @gear, method: :delete, data: { turbo_confirm: "Delete #{@gear.name} and all its components, expenses and readings?" } %>
</div>

<% if @gear.parent_id.nil? %>
  <h2>Components</h2>
  <p class="muted">Parts with their own purchase history, like a set of tires.</p>
  <p><%= link_to "Add component", new_gear_path(parent_id: @gear.id) %></p>
  <% if @components.any? %>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Name</th><th>Purchased</th><th>From</th><th class="num">Total cost</th></tr>
        </thead>
        <tbody>
          <% @components.each do |component| %>
            <tr>
              <td><%= link_to component.name, component %></td>
              <td><%= component.purchased_on %></td>
              <td><%= component.purchased_from %></td>
              <td class="num"><%= money component.total_cost %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<h2>Expenses</h2>
<p><%= link_to "Add expense", new_gear_expense_path(@gear) %></p>
<% if @expenses.any? %>
  <div class="scroll">
    <table>
      <thead>
        <tr><th>Date</th><th>Description</th><th>Category</th><th>Vendor</th><th class="num">Amount</th><th></th></tr>
      </thead>
      <tbody>
        <% @expenses.each do |expense| %>
          <tr>
            <td><%= expense.spent_on %></td>
            <td><%= expense.description %></td>
            <td><%= expense.category %></td>
            <td><%= expense.vendor %></td>
            <td class="num"><%= money expense.amount %></td>
            <td><%= link_to "Edit", edit_gear_expense_path(@gear, expense) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<h2>Readings</h2>
<p class="muted">Measurements over time, like tire pressure or odometer.</p>
<p><%= link_to "Add reading", new_gear_reading_path(@gear) %></p>
<% if @readings.any? %>
  <div class="scroll">
    <table>
      <thead>
        <tr><th>Date</th><th>Reading</th><th class="num">Value</th><th>Unit</th><th></th></tr>
      </thead>
      <tbody>
        <% @readings.each do |reading| %>
          <tr>
            <td><%= reading.read_on %></td>
            <td><%= reading.name %></td>
            <td class="num"><%= number_with_precision reading.value, precision: 3, strip_insignificant_zeros: true %></td>
            <td><%= reading.unit %></td>
            <td><%= link_to "Edit", edit_gear_reading_path(@gear, reading) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
