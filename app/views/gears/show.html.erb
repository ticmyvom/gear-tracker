<% content_for :title, @gear.name %>
<% if @gear.parent %>
  <p><%= link_to "< #{@gear.parent.name}", @gear.parent %></p>
<% else %>
  <p><%= link_to "< My gear", gears_path %></p>
<% end %>

<h1><%= @gear.name %></h1>

<dl>
  <dt>Category</dt><dd><%= @gear.category_name || "-" %></dd>
  <% if @gear.vehicle? && @gear.nickname %>
    <dt>Vehicle</dt><dd><%= @gear.vehicle_name || "-" %></dd>
  <% end %>
  <dt>Powered by</dt><dd><%= @gear.power_source_name || "Not powered" %></dd>
  <dt>Purchased</dt><dd><%= @gear.purchased_on || "-" %></dd>
  <dt>Bought from</dt><dd><%= @gear.purchased_from.presence || "-" %></dd>
  <dt>Price</dt><dd><%= money @gear.price, @gear.currency %></dd>
  <dt>Total cost</dt><dd><%= money @gear.total_cost %></dd>
  <dt>Cost per year</dt><dd><%= money @gear.cost_per_year %></dd>
  <% if @gear.parent_id.nil? %>
    <dt>Public profile</dt><dd><%= @gear.public? ? (@gear.public_costs? ? "Shown, with costs" : "Shown, without costs") : "Not shown" %></dd>
  <% end %>
</dl>

<% if @gear.notes.present? %>
  <p class="notes"><%= @gear.notes %></p>
<% end %>

<div class="actions">
  <%= link_to "Edit", edit_gear_path(@gear) %>
  <%= button_to "Delete", @gear, method: :delete, data: { turbo_confirm: "Delete #{@gear.name} and all its components, expenses, fuel entries and readings?" } %>
</div>

<% if @gear.parent_id.nil? %>
  <h2>Components</h2>
  <p class="muted">Parts with their own purchase history, like a set of tires.</p>
  <p><%= link_to "Add component", new_gear_path(parent_id: @gear.id) %></p>
  <% if @components.any? %>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Name</th><th>Purchased</th><th>From</th><th class="num">Total cost</th></tr>
        </thead>
        <tbody>
          <% @components.each do |component| %>
            <tr>
              <td><%= link_to component.name, component %></td>
              <td><%= component.purchased_on %></td>
              <td><%= component.purchased_from %></td>
              <td class="num"><%= money component.total_cost %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<% fuel_units = (@gear.fuel_units + @fuel_entries.map(&:unit)).uniq %>
<% if fuel_units.any? %>
  <h2><%= FuelEntry.log_name_for(fuel_units) %></h2>
  <p class="muted">Add the time used to see the rate (watts for electricity)<%= ", or distance to see efficiency" if @gear.vehicle? %>.</p>
  <% if @gear.fuel_units.any? %>
    <p class="actions">
      <% @gear.fuel_units.each do |unit| %>
        <%= link_to "Add #{FuelEntry.label_for(unit)}", new_gear_fuel_entry_path(@gear, unit: unit) %>
      <% end %>
    </p>
  <% end %>
  <% if @fuel_entries.any? %>
    <%# Columns nobody has filled in are left out. %>
    <% show_time = @fuel_entries.any?(&:minutes) %>
    <% show_distance = @fuel_entries.any? { it.odometer || it.trip } %>
    <% fuel_notes = any_notes?(@fuel_entries) %>
    <div class="scroll">
      <table>
        <thead>
          <tr>
            <th>Date</th><th class="num">Amount</th><th class="num">Total price</th>
            <% if show_time %><th class="num">Time used</th><th class="num">Rate</th><% end %>
            <% if show_distance %><th class="num">Odometer</th><th class="num">Distance</th><th class="num">Efficiency</th><% end %>
            <% if fuel_notes %><th>Notes</th><% end %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @fuel_entries.each do |fuel_entry| %>
            <tr>
              <td><%= fuel_entry.filled_on %></td>
              <td class="num"><%= quantity fuel_entry.entered_amount %> <%= fuel_entry.amount_label %><%= tag.small(" partial") unless fuel_entry.filled_up? %><%= tag.small(" about #{fuel_entry.missed_before} missed before") if fuel_entry.missed_previous? %></td>
              <td class="num"><%= money fuel_entry.total_price, fuel_entry.currency %></td>
              <% if show_time %>
                <td class="num"><%= duration fuel_entry.minutes %></td>
                <td class="num"><% if fuel_entry.usage_rate %><%= rate fuel_entry.usage_rate %> <%= fuel_entry.usage_rate_label %><% end %></td>
              <% end %>
              <% if show_distance %>
                <td class="num"><%= distance fuel_entry.entered_odometer %></td>
                <td class="num"><%= distance fuel_entry.distance %></td>
                <td class="num"><% if fuel_entry.distance_per_unit %><%= number_with_precision fuel_entry.distance_per_unit, precision: 1 %> <%= fuel_entry.efficiency_label %><% if fuel_entry.efficiency_flag %><br><small><%= link_to "Unusually #{fuel_entry.efficiency_flag}: check", edit_gear_fuel_entry_path(@gear, fuel_entry) %></small><% end %><% end %></td>
              <% end %>
              <% if fuel_notes %><td class="notes"><%= fuel_entry.notes %></td><% end %>
              <td><%= link_to "Edit", edit_gear_fuel_entry_path(@gear, fuel_entry) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<h2>Expenses</h2>
<p><%= link_to "Add expense", new_gear_expense_path(@gear) %></p>
<% if @expenses.any? %>
  <% expense_notes = any_notes?(@expenses) %>
  <div class="scroll">
    <table>
      <thead>
        <tr><th>Date</th><th>Description</th><th>Category</th><th>Vendor</th><th class="num">Amount</th><% if expense_notes %><th>Notes</th><% end %><th></th></tr>
      </thead>
      <tbody>
        <% @expenses.each do |expense| %>
          <tr>
            <td><%= expense.spent_on %></td>
            <td><%= expense.description %></td>
            <td><%= expense.category_name %></td>
            <td><%= expense.vendor %></td>
            <td class="num"><%= money expense.amount, expense.currency %></td>
            <% if expense_notes %><td class="notes"><%= expense.notes %></td><% end %>
            <td><%= link_to "Edit", edit_gear_expense_path(@gear, expense) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<h2>Readings</h2>
<p class="muted">Measurements over time, like tire pressure or odometer.</p>
<p><%= link_to "Add reading", new_gear_reading_path(@gear) %></p>
<% if @readings.any? %>
  <% reading_notes = any_notes?(@readings) %>
  <% reading_odometer = @readings.any?(&:odometer) %>
  <div class="scroll">
    <table>
      <thead>
        <tr><th>Date</th><th>Reading</th><th class="num">Value</th><th>Unit</th><% if reading_odometer %><th class="num">Odometer (<%= @readings.first.distance_label %>)</th><% end %><% if reading_notes %><th>Notes</th><% end %><th></th></tr>
      </thead>
      <tbody>
        <% @readings.each do |reading| %>
          <tr>
            <td><%= reading.read_on %></td>
            <td><%= reading.name %></td>
            <td class="num"><%= quantity reading.value %></td>
            <td><%= reading.unit %></td>
            <% if reading_odometer %><td class="num"><%= distance reading.entered_odometer %></td><% end %>
            <% if reading_notes %><td class="notes"><%= reading.notes %></td><% end %>
            <td><%= link_to "Edit", edit_gear_reading_path(@gear, reading) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
