<% content_for :title, "Settings" %>
<h1>Settings</h1>

<%= form_with model: @user, url: settings_path, method: :patch do |form| %>
  <%= render "shared/errors", record: @user %>

  <div>
    <%= form.label :currency %>
    <%= form.select :currency, User::CURRENCIES.map { |code, currency| [ "#{currency[:name]} (#{currency[:symbol]})", code ] } %>
    <p class="muted">The default for new prices and expenses. Each one can use a different currency, and amounts you already entered keep theirs.</p>
  </div>
  <div>
    <%= form.label :distance_unit, "Distance" %>
    <%= form.select :distance_unit, Units::DISTANCES.invert %>
  </div>
  <div>
    <%= form.label :volume_unit, "Fuel volume" %>
    <%= form.select :volume_unit, Units::VOLUMES.invert %>
    <p class="muted">Fuel entries you already made are shown in the new units.</p>
  </div>
  <div class="actions">
    <%= form.submit "Save settings" %>
    <%= link_to "Cancel", root_path %>
  </div>
<% end %>

<h2>Public profile</h2>
<p class="muted">Off by default. When it's on, you're listed on the <%= link_to "People", profiles_path %> page, and anyone can see your display name and the gear you mark public, and your name is shown with any vehicle you listed on the <%= link_to "Vehicles", vehicles_path %> page. Nothing else: never your email or your other gear.</p>
<%= form_with model: @user, url: settings_path, method: :patch do |form| %>
  <div>
    <%= form.label :display_name %>
    <%= form.text_field :display_name, maxlength: 50, placeholder: "Trail Runner" %>
  </div>
  <div>
    <%= form.label :username %>
    <%= form.text_field :username, maxlength: 30, autocapitalize: "none", spellcheck: false, placeholder: "trail-runner" %>
    <p class="muted">Your profile's address: <%= profile_url(username: "username") %>. Lowercase letters, numbers and dashes.</p>
  </div>
  <div>
    <%= form.label :profile_public do %>
      <%= form.check_box :profile_public %> Make my profile public
    <% end %>
  </div>
  <% if @user.profile_public? && @user.username_in_database %>
    <p>Your profile: <%= link_to profile_url(username: @user.username_in_database), profile_path(username: @user.username_in_database) %></p>
  <% end %>
  <%= form.submit "Save profile" %>
<% end %>

<h2>API tokens</h2>
<p class="muted">Let an agent or script read and log your gear through the <%= link_to "API", api_v1_docs_path %>. Give each agent its own token, so you can revoke one without affecting the others.</p>

<% tokens = Current.user.api_tokens.order(:created_at) %>
<% if tokens.any? %>
  <div class="scroll">
    <table>
      <thead>
        <tr><th>Name</th><th>Access</th><th>Created</th><th>Last used</th><th></th></tr>
      </thead>
      <tbody>
        <% tokens.each do |token| %>
          <tr>
            <td><%= token.name %></td>
            <td><%= ApiToken::PERMISSIONS[token.permission] %></td>
            <td><%= token.created_at.to_date %></td>
            <td><%= token.last_used_at&.to_date || "Never" %></td>
            <td><%= button_to "Revoke", token, method: :delete, data: { turbo_confirm: "Revoke #{token.name}? Agents using it will stop working." } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%# Turbo is off so the new token is shown directly, without a redirect that would carry it in a cookie. %>
<%= form_with model: @api_token, data: { turbo: false } do |form| %>
  <%= render "shared/errors", record: @api_token %>

  <div>
    <%= form.label :name, "New token name" %>
    <%= form.text_field :name, required: true, maxlength: 100, placeholder: "Claude on my laptop" %>
  </div>
  <div>
    <%= form.label :permission, "Access" %>
    <%= form.select :permission, ApiToken::PERMISSIONS.invert %>
  </div>
  <%= form.submit "Create token" %>
<% end %>

<h2>Your data</h2>
<p><%= link_to "Download all your data", export_account_path %> <span class="muted">(a JSON file you can keep or move elsewhere)</span></p>

<h3>Import data</h3>
<% if Current.user.gears.exists? %>
  <p class="muted">Importing a downloaded file only works into an account with no gear, so nothing gets copied twice.</p>
<% else %>
  <p class="muted">Brings in the gear and records from a downloaded file, converted to your units.</p>
  <%= form_with url: import_account_path, multipart: true do |form| %>
    <div>
      <%= form.label :file, "Data file" %>
      <%= form.file_field :file, accept: ".json,application/json", required: true %>
    </div>
    <%= form.submit "Import" %>
  <% end %>
<% end %>

<h3>Delete your account</h3>
<p class="muted">Deletes your account and everything you entered, right away. This can't be undone, so download your data first if you want a copy.</p>
<%= form_with url: account_path, method: :delete, data: { turbo_confirm: "Delete your account and all your data? This can't be undone." } do |form| %>
  <div>
    <%= form.label :password, "Your password" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>
  <%= form.submit "Delete my account" %>
<% end %>
